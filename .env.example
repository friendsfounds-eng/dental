# ==============================================================================
# APEX DENTAL CLINIC ERP & ODONTOGRAM MANAGEMENT SYSTEM
# Environment Configuration Template
# ==============================================================================

# Server Network Settings
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Medical Vault & Encryption
# Optional: 32+ character master key to encrypt radiograph DICOM files & clinical scans
# If left blank, an encryption key is automatically generated in server/data/.vault_master_key
CLINIC_VAULT_ENCRYPTION_KEY=your-secure-random-32-char-clinic-secret-key-here

# Optional: Cloud Object Storage (AWS S3)
# If provided, encrypted radiograph images can also be synced to AWS S3.
# If omitted, all files are stored securely in local encrypted disk vault.
# AWS_S3_BUCKET=apex-dental-records-vault
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
